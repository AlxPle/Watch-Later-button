{
  "name": "watch-later-button-root",
  "version": "1.6.5",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-zip",
    "test": "npm --prefix tests run test-locales",
    "test:locales": "npm --prefix tests run test-locales",
    "test:e2e": "npm --prefix tests test -- e2e.test.js",
    "test:content": "npm --prefix tests run test:content",
    "test:docs": "node tests/check-docs-puppeteer.cjs",
    "ci": "npm run build && npm run test:content && npm run test:locales",
    "chrome:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-chrome-debug.ps1",
    "chrome:debug:check": "curl -fsS http://127.0.0.1:9222/json/version",
    "devtools:relay": "node scripts/devtools-relay.mjs"
  }
}
